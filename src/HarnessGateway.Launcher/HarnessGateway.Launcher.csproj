<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <!-- Exclusively net10.0, so no TFM condition: gates the trim/AOT/single-file
             analyzers on every build, keeping the launcher publishable with
             PublishAot/PublishTrimmed without new IL warnings creeping in. -->
        <IsAotCompatible>true</IsAotCompatible>
        <!-- Binary is `harnessgateway`; project and namespace stay HarnessGateway.Launcher (one CLI project owns proxy verbs later). -->
        <AssemblyName>harnessgateway</AssemblyName>
        <PackageId>HarnessGateway</PackageId>
        <Authors>Alastair Lundy</Authors>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Pinned build identity: surfaced by the version flag and asserted
             against the release tag. Distinct from settings `schemaVersion`. -->
        <Version>0.1.1</Version>
        <!-- The SDK's built-in SourceLink stamps SourceRevisionId (the git
             commit SHA) onto the informational version as "+<sha>" whenever a
             build runs in a checkout. Off: the version flag prints the pin
             exactly, so its output is bare Major.Minor.Patch and nothing else.
             Source linking itself is unaffected - the SHA still lands in the
             PDB. -->
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

        <!-- The Windows RIDs this launcher publishes for: the release zip matrix and the
             installer's two MSIs package the same self-contained publish output. Declared
             here so one `dotnet restore` covers every RID the build publishes, which keeps
             RID-specific publishes out of the build phase (no mid-build restore). -->
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/alastairlundy/HarnessGateway</RepositoryUrl>
        <Title>HarnessGateway</Title>
        <Copyright>Copyright (c) 2026 Alastair Lundy</Copyright>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>Initial Release</PackageReleaseNotes>
        <AssemblyVersion>0.1.1</AssemblyVersion>
        <FileVersion>0.1.1</FileVersion>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="HarnessGateway.Launcher.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CliInvoke" />
      <PackageReference Include="Meziantou.Analyzer">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Spectre.Console" />
      <PackageReference Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\HarnessGateway.Launcher.Core\HarnessGateway.Launcher.Core.csproj" />
    </ItemGroup>

</Project>
