<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackAsTool>true</PackAsTool>
        <ToolCommandName>harnessgateway</ToolCommandName>
        <PackageId>harnessgateway</PackageId>
        <Version>0.1.0</Version>
        <Description>Launch agent harnesses with the specified backend configuration.</Description>
        <PackageTags>agent;cli;tool</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/alastairlundy/HarnessGateway</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="HarnessGateway.Launcher.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CliInvoke" />
      <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
      <PackageReference Include="Spectre.Console" />
      <PackageReference Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\HarnessGateway.Launcher.Core\HarnessGateway.Launcher.Core.csproj" />
    </ItemGroup>

</Project>
