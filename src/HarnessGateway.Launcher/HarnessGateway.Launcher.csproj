<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <!-- Binary is `harnessgateway`; project and namespace stay HarnessGateway.Launcher (D017: one CLI project owns proxy verbs later). -->
        <AssemblyName>harnessgateway</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/alastairlundy/HarnessGateway</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="HarnessGateway.Launcher.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CliInvoke" />
      <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
      <PackageReference Include="Spectre.Console" />
      <PackageReference Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\HarnessGateway.Launcher.Core\HarnessGateway.Launcher.Core.csproj" />
    </ItemGroup>

</Project>
