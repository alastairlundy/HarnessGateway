<Project DefaultTargets="Build">

  <!--
    MSBuild resolves a project SDK's version from this file or from global.json; it never
    reads Central Package Management. To keep the WiX tooling version in
    Directory.Packages.props like every other package version in this repository, import
    that file first and hand its pinned value to the SDK imports below. The three NuGet
    properties tell restore where the central versions came from and stop NuGet.props
    importing the file a second time now that it is already imported here.
  -->
  <PropertyGroup>
    <_CentralPackageVersions>$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)'))</_CentralPackageVersions>
    <ImportDirectoryPackagesProps>false</ImportDirectoryPackagesProps>
    <DirectoryPackagesPropsPath Condition="Exists('$(_CentralPackageVersions)')">$(_CentralPackageVersions)</DirectoryPackagesPropsPath>
    <CentralPackageVersionsFileImported Condition="Exists('$(_CentralPackageVersions)')">true</CentralPackageVersionsFileImported>
  </PropertyGroup>
  <Import Project="$(_CentralPackageVersions)" Condition="Exists('$(_CentralPackageVersions)')" />

  <PropertyGroup>
    <!--
      One solution build produces one MSI per Windows RID: this project builds the win-x64
      MSI itself and runs a second pass below for win-arm64.
    -->
    <InstallerRuntimeIdentifier Condition="'$(InstallerRuntimeIdentifier)' == ''">win-x64</InstallerRuntimeIdentifier>
    <InstallerPlatform Condition="'$(InstallerRuntimeIdentifier)' == 'win-arm64'">arm64</InstallerPlatform>
    <InstallerPlatform Condition="'$(InstallerPlatform)' == ''">x64</InstallerPlatform>
    <!-- Output names mirror the release archives: harnessgateway-<rid>.msi. -->
    <OutputName>harnessgateway-$(InstallerRuntimeIdentifier)</OutputName>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="WixToolset.Sdk" Version="$(WixToolsetVersion)" />

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>

  <!-- Per-RID intermediate output so each pass keeps its own objects and bind tracking. -->
  <PropertyGroup>
    <IntermediateOutputPath>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(InstallerRuntimeIdentifier)\</IntermediateOutputPath>
    <!-- Where the Launcher's self-contained publish output is staged for this MSI's payload. -->
    <LauncherPublishDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(InstallerRuntimeIdentifier)\launcher-publish</LauncherPublishDir>
    <!--
      Build root for the payload publish. The solution also builds the Launcher and its
      references in this same build, and a referenced project's output folder does not
      change with the Runtime Identifier - so publishing into the shared bin/obj would put
      two writes to the same file in flight at once. Keeping this build under its own root
      makes the payload build disjoint from every other project in the solution.
    -->
    <LauncherBuildDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(InstallerRuntimeIdentifier)\launcher-build\</LauncherBuildDir>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="WixToolset.Sdk" Version="$(WixToolsetVersion)" />

  <!--
    WiX authors Windows Installer packages and its toolchain runs on Windows only: on any
    other platform wix.exe refuses outright rather than degrading. Restrict the installer to
    Windows builds. Elsewhere the project still restores and evaluates, so solution builds
    stay green across the whole CI matrix; it just produces nothing. The payload publish and
    the second RID pass below are both downstream of Build, so they never run either.
  -->
  <PropertyGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' != 'true'">
    <BuildDependsOn></BuildDependsOn>
  </PropertyGroup>

  <!--
    Publish the Launcher for this RID and hand the payload path plus the product version to
    Package.wxs. The payload comes from the Launcher build; the version comes from the Launcher
    csproj's pinned <Version> (under AOT there is no managed payload dll to read an identity
    from). Neither is restated in this project. The one exception is the payload's publish
    shape: it is pinned in the Properties string below (Native AOT, matching the release
    archives).
  -->
  <Target Name="PublishLauncherPayload" BeforeTargets="CoreCompile">
    <!--
      The payload publish runs through the dotnet CLI rather than the MSBuild task because
      PublishAot must reach restore: `dotnet publish` re-restores with the same properties
      before publishing (the ILCompiler runtime pack only enters the assets file that way),
      while a raw MSBuild Publish reuses whatever assets file the solution restore last wrote
      and silently falls back to a JIT payload. The build stays in this project's disjoint
      launcher-build tree (BaseOutputPath/IntermediateOutputPath), so the payload never writes
      into the shared bin/obj the solution build uses; no obj-root override is needed - the
      payload's implicit restore simply rewrites the shared assets file to the AOT shape,
      which plain builds and publishes are unaffected by.
    -->
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\HarnessGateway.Launcher\HarnessGateway.Launcher.csproj&quot; -c $(Configuration) -r $(InstallerRuntimeIdentifier) --self-contained true -p:PublishSingleFile=false -p:PublishAot=true -p:CopyOutputSymbolsToPublishDirectory=false -p:BaseOutputPath=&quot;$(LauncherBuildDir)bin/&quot; -p:IntermediateOutputPath=&quot;$(LauncherBuildDir)obj/&quot; -p:PublishDir=&quot;$(LauncherPublishDir)/&quot;" />

    <!-- The release archives ship without symbols, so the staged payload must too. AOT
         publish can still stage referenced projects' pdbs (CopyOutputSymbolsToPublishDirectory
         does not cover them), so delete any symbols before packaging. -->
    <ItemGroup>
      <_PayloadSymbols Include="$(LauncherPublishDir)\**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PayloadSymbols)" />

    <!--
      The payload version. Under AOT the publish output is a single native exe with no managed
      harnessgateway.dll to read an assembly identity from, so the version is read from the
      Launcher csproj's pinned <Version> - the same source of truth the publish workflow's
      tag assertion checks against. It is never restated here.
    -->
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\HarnessGateway.Launcher\HarnessGateway.Launcher.csproj"
             Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="_LauncherVersion" />
    </XmlPeek>

    <PropertyGroup>
      <!-- Windows Installer takes Major.Minor.Build only, so drop the revision component. -->
      <LauncherProductVersion>$([System.Text.RegularExpressions.Regex]::Match($(_LauncherVersion), '^\d+\.\d+\.\d+').Value)</LauncherProductVersion>
      <DefineConstants>ProductVersion=$(LauncherProductVersion);LauncherPublishDir=$(LauncherPublishDir);$(DefineConstants)</DefineConstants>
    </PropertyGroup>
  </Target>

  <!-- Second pass: the win-arm64 MSI, built after this project's own build so a single solution build ships both. -->
  <Target Name="BuildWinArm64Installer"
          AfterTargets="Build"
          Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true' and '$(InstallerRuntimeIdentifier)' != 'win-arm64'">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Build"
             Properties="Configuration=$(Configuration);InstallerRuntimeIdentifier=win-arm64" />
  </Target>

</Project>
