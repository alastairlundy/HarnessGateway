<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackAsTool>true</PackAsTool>
        <ToolCommandName>lmlaunch</ToolCommandName>
        <PackageId>lmlaunch</PackageId>
        <Version>0.1.0</Version>
        <Description>Launch agent harnesses with the specified backend configuration.</Description>
        <PackageTags>agent;cli;tool</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/alast/LmProxy</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="LmProxy.AgentLauncher.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CliInvoke" Version="3.0.0-beta.3" />
      <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
      <PackageReference Include="Spectre.Console" Version="0.57.2" />
      <PackageReference Include="System.CommandLine" Version="2.0.12" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\LmProxy.AgentLauncher.Core\LmProxy.AgentLauncher.Core.csproj" />
    </ItemGroup>

</Project>
