<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      WiX tooling version, pinned centrally like every other package version in this
      repository. MSBuild resolves a project SDK's version from the project file or from
      global.json and never consults Directory.Packages.props, so the installer project
      imports this file itself and passes $(WixToolsetVersion) to its SDK imports instead
      of repeating the version anywhere else.
    -->
    <WixToolsetVersion>6.0.2</WixToolsetVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CliInvoke" Version="3.1.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.324" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageVersion Include="Tomlyn" Version="2.11.1" />
    <PackageVersion Include="TUnit" Version="1.83.0" />
    <PackageVersion Include="WixToolset.Sdk" Version="$(WixToolsetVersion)" />
    <PackageVersion Include="WixToolset.UI.wixext" Version="$(WixToolsetVersion)" />
  </ItemGroup>
</Project>
