<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Exclusively net10.0, so no TFM condition: gates the trim/AOT/single-file
             analyzers on every build, keeping the app publishable with
             PublishAot/PublishTrimmed without new IL warnings creeping in. -->
        <IsAotCompatible>true</IsAotCompatible>

        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
        <Version>0.1.1</Version>
    </PropertyGroup>

    <ItemGroup>
        <!-- IVT targets assembly names; the launcher exe's assembly is `harnessgateway`. -->
        <InternalsVisibleTo Include="harnessgateway" />
        <InternalsVisibleTo Include="HarnessGateway.Launcher.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CliInvoke" />
        <PackageReference Include="Meziantou.Analyzer">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.Security.Cryptography.ProtectedData" />
        <PackageReference Include="Tomlyn" />
    </ItemGroup>

</Project>
